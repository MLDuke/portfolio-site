{
  "theme": {
    "focus-ring": {
      "color": {
        "$type": "color",
        "$value": "{theme.on-surface.primary}",
        "$extensions": { "mode": {
          "light": "{theme.on-surface.primary}",
          "dark":  "{theme.on-surface.primary}"
        } }
      },
      "width": {
        "$type": "dimension",
        "$value": "{global.size-unit.2}",
        "$extensions": { "mode": {
          "light": "{global.size-unit.2}",
          "dark":  "{global.size-unit.2}"
        } }
      },
      "offset": {
        "$type": "dimension",
        "$value": "{global.size-unit.2}",
        "$extensions": { "mode": {
          "light": "{global.size-unit.2}",
          "dark":  "{global.size-unit.2}"
        } }
      }
    }
  }
}
