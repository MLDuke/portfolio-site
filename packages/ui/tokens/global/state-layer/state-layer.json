{
  "global": {
    "state-layer": {
      "on-light": {
        "hover":    { "$type": "color", "$value": "rgb(0 6 17 / 0.08)" },
        "pressed":  { "$type": "color", "$value": "rgb(0 6 17 / 0.12)" },
        "selected": { "$type": "color", "$value": "rgb(0 6 17 / 0.16)" }
      },
      "on-dark": {
        "hover":    { "$type": "color", "$value": "rgb(249 252 255 / 0.08)" },
        "pressed":  { "$type": "color", "$value": "rgb(249 252 255 / 0.12)" },
        "selected": { "$type": "color", "$value": "rgb(249 252 255 / 0.16)" }
      }
    }
  }
}
