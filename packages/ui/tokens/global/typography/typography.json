{
  "global": {
    "typography": {
      "font-family": {
        "sans": { "$type": "fontFamily", "$value": "var(--font-ibm-plex-sans), ui-sans-serif, system-ui, sans-serif" },
        "mono": { "$type": "fontFamily", "$value": "var(--font-ibm-plex-mono), ui-monospace, \"SFMono-Regular\", \"Roboto Mono\", \"Cascadia Code\", monospace" }
      },
      "font-weight": {
        "regular":  { "$type": "fontWeight", "$value": 400 },
        "medium":   { "$type": "fontWeight", "$value": 500 },
        "semibold": { "$type": "fontWeight", "$value": 600 },
        "bold":     { "$type": "fontWeight", "$value": 700 }
      },
      "font-size": {
        "display-large":  { "$type": "dimension", "$value": "32px" },
        "display-medium": { "$type": "dimension", "$value": "28px" },
        "display-small":  { "$type": "dimension", "$value": "24px" },
        "heading-large":  { "$type": "dimension", "$value": "24px" },
        "heading-medium": { "$type": "dimension", "$value": "20px" },
        "heading-small":  { "$type": "dimension", "$value": "16px" },
        "body-large":     { "$type": "dimension", "$value": "20px" },
        "body-medium":    { "$type": "dimension", "$value": "16px" },
        "body-small":     { "$type": "dimension", "$value": "14px" },
        "label-large":    { "$type": "dimension", "$value": "16px" },
        "label-medium":   { "$type": "dimension", "$value": "14px" },
        "label-small":    { "$type": "dimension", "$value": "12px" }
      },
      "line-height": {
        "display-large":  { "$type": "dimension", "$value": "36px" },
        "display-medium": { "$type": "dimension", "$value": "32px" },
        "display-small":  { "$type": "dimension", "$value": "28px" },
        "heading-large":  { "$type": "dimension", "$value": "32px" },
        "heading-medium": { "$type": "dimension", "$value": "28px" },
        "heading-small":  { "$type": "dimension", "$value": "24px" },
        "body-large":     { "$type": "dimension", "$value": "28px" },
        "body-medium":    { "$type": "dimension", "$value": "24px" },
        "body-small":     { "$type": "dimension", "$value": "20px" },
        "label-large":    { "$type": "dimension", "$value": "24px" },
        "label-medium":   { "$type": "dimension", "$value": "20px" },
        "label-small":    { "$type": "dimension", "$value": "16px" }
      }
    }
  }
}
