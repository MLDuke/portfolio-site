{
  "theme": {
    "interaction": {
      "duration": {
        "$type": "duration",
        "$value": "{global.motion.duration.fast}",
        "$extensions": { "mode": {
          "light": "{global.motion.duration.fast}",
          "dark":  "{global.motion.duration.fast}"
        } }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{global.motion.easing.standard}",
        "$extensions": { "mode": {
          "light": "{global.motion.easing.standard}",
          "dark":  "{global.motion.easing.standard}"
        } }
      }
    }
  }
}
