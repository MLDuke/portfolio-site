        "$value": "{global.color.neutral.0}",
        "$extensions": { "mode": { "light": "{global.color.neutral.0}", "dark": "{global.color.neutral.10}" } }
      },
      "raised": {
        "$type": "color",
        "$value": "{global.color.neutral.0-5}",
